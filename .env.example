# Optional: Public site URL used for Open Graph & canonical metadata
NEXT_PUBLIC_SITE_URL=https://craftcv-resume.vercel.app

# Optional: Supabase credentials for cloud resume backup & Google/Email login
# Leave empty to run 100% client-side with localStorage autosave (login UI will be hidden automatically)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
